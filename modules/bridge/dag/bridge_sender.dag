    components {

        class_name: "UDPBridgeSenderComponent<localization::LocalizationEstimate>"
        config {
            name: "bridge_sender_LocalizationEstimate"
            config_file_path: "/apollo/modules/bridge/conf/udp_bridge_sender_localization.pb.txt"
            readers {
              channel: "/apollo/localization/pose"
            }
      }
   }

   components {

        class_name: "UDPBridgeSenderComponent<perception::PerceptionObstacles>"
        config {
            name: "bridge_sender_PerceptionObstacles"
            config_file_path: "/apollo/modules/bridge/conf/udp_bridge_sender_perception.pb.txt"
            readers {
              channel: "/apollo/perception/obstacles"
            }
      }
   }

   components {

        class_name: "UDPBridgeSenderComponent<perception::TrafficLightDetection>"
        config {
            name: "bridge_sender_TrafficLightDetection"
            config_file_path: "/apollo/modules/bridge/conf/udp_bridge_sender_trafficlight.pb.txt"
            readers {
              channel: "/apollo/perception/traffic_light"
            }
      }
   }

   components {

        class_name: "UDPBridgeSenderComponent<transform::TransformStampeds>"
        config {
            name: "bridge_sender_tf"
            config_file_path: "/apollo/modules/bridge/conf/udp_bridge_sender_tf.pb.txt"
            readers {
              channel: "/tf"
            }
      }
   }
}
