# Define all coms in DAG streaming.

module_config {
    module_library : "modules/drivers/lidar/velodyne/fusion/libvelodyne_fusion_component.so"

    components {
      class_name : "PriSecFusionComponent"
      config {
        name : "seyond_fusion"
        config_file_path : "modules/drivers/lidar/seyond/conf/seyond_fusion_conf.pb.txt"
        readers {channel: "/apollo/sensor/seyond/front/PointCloud2"}
      }
    }
}