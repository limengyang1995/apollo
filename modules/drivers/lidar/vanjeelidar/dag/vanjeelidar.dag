module_config {
    module_library : "modules/drivers/lidar/vanjeelidar/libvanjeelidar_component.so"
    components {
        class_name : "VanjeelidarComponent"
        config {
          name : "VanjeeLiDAR_Driver"
          config_file_path : "/apollo/modules/drivers/lidar/vanjeelidar/conf/vanjeelidar.pb.txt"
        }
    }    
    components {
        class_name : "VanjeelidarComponent"
        config {
          name : "VanjeeLiDAR_Left_Driver"
          config_file_path : "/apollo/modules/drivers/lidar/vanjeelidar/conf/vanjeelidar_left.pb.txt"
        }
    }

    components {
        class_name : "VanjeelidarComponent"
        config {
          name : "VanjeeLiDAR_Right_Driver"
          config_file_path : "/apollo/modules/drivers/lidar/vanjeelidar/conf/vanjeelidar_right.pb.txt"
        }
    }
}
