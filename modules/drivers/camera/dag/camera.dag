# Define all coms in DAG streaming.
module_config {
    module_library : "modules/drivers/camera/libcamera_component.so"

    components {
      class_name : "CameraComponent"
      config {
        name : "camera_front_fisheye"
        config_file_path : "modules/drivers/camera/conf/camera_front_fisheye.pb.txt"
      }
    }

    components {
      class_name : "CameraComponent"
      config {
        name : "camera_left_front_fisheye"
        config_file_path : "modules/drivers/camera/conf/camera_left_front_fisheye.pb.txt"
      }
    }

    components {
      class_name : "CameraComponent"
      config {
        name : "camera_right_front_fisheye"
        config_file_path : "modules/drivers/camera/conf/camera_right_front_fisheye.pb.txt"
      }
    }
    components {
      class_name : "CameraComponent"
      config {
        name : "camera_right_fisheye"
        config_file_path : "modules/drivers/camera/conf/camera_right_fisheye.pb.txt"
      }
    }

    components {
      class_name : "CameraComponent"
      config {
        name : "camera_rear_fisheye"
        config_file_path : "modules/drivers/camera/conf/camera_rear_fisheye.pb.txt"
      }
    }

    components {
      class_name : "CameraComponent"
      config {
        name : "camera_left_fisheye"
        config_file_path : "modules/drivers/camera/conf/camera_left_fisheye.pb.txt"
      }
    }
    
}

